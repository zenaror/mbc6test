; Game Boy / Game Boy Color hardware I/O register addresses.
; Standard factual register map (Pan Docs: https://gbdev.io/pandocs/).
; Only the subset actually used by this test ROM is defined here —
; this is not a general-purpose hardware.inc clone.

; ---- Joypad ----
DEF rP1 EQU $FF00

; ---- Interrupts ----
DEF rIF EQU $FF0F
DEF rIE EQU $FFFF

DEF IEF_VBLANK EQU %00000001
DEF IEF_LCDC EQU %00000010
DEF IEF_TIMER EQU %00000100
DEF IEF_SERIAL EQU %00001000
DEF IEF_HILO EQU %00010000

; ---- LCD ----
DEF rLCDC EQU $FF40
DEF rSTAT EQU $FF41
DEF rSCY EQU $FF42
DEF rSCX EQU $FF43
DEF rLY EQU $FF44
DEF rLYC EQU $FF45
DEF rDMA EQU $FF46
DEF rBGP EQU $FF47
DEF rOBP0 EQU $FF48
DEF rOBP1 EQU $FF49
DEF rWY EQU $FF4A
DEF rWX EQU $FF4B

DEF LCDCF_ON EQU %10000000
DEF LCDCF_BG9C00 EQU %00001000
DEF LCDCF_BG8000 EQU %00010000
DEF LCDCF_BGON EQU %00000001
DEF LCDCF_OBJ8 EQU %00000100
DEF LCDCF_OBJON EQU %00000010
DEF LCDCF_WINON EQU %00100000
DEF LCDCF_WIN9C00 EQU %01000000

DEF STATF_LYC EQU %00000100

; ---- CGB-only registers ----
DEF rKEY1 EQU $FF4D
DEF rVBK EQU $FF4F
DEF rHDMA1 EQU $FF51
DEF rHDMA2 EQU $FF52
DEF rHDMA3 EQU $FF53
DEF rHDMA4 EQU $FF54
DEF rHDMA5 EQU $FF55
DEF rBCPS EQU $FF68
DEF rBCPD EQU $FF69
DEF rOCPS EQU $FF6A
DEF rOCPD EQU $FF6B
DEF rSVBK EQU $FF70
DEF rOPRI EQU $FF6C

DEF KEY1F_DOUBLE EQU %10000000
DEF KEY1F_PREPARE EQU %00000001

DEF BCPSF_AUTOINC EQU %10000000

; ---- Boot ROM disable / CGB boot-state carrier ----
DEF rKEY0 EQU $FF4C

; ---- VRAM / tile map ----
DEF _VRAM EQU $8000
DEF _VRAM8000 EQU $8000
DEF _VRAM9000 EQU $9000
DEF _SCRN0 EQU $9800
DEF _SCRN1 EQU $9C00

; ---- WRAM / OAM ----
DEF _RAM EQU $C000
DEF _OAMRAM EQU $FE00

; ---- SRAM window (fixed CPU addresses, banked by MBC6) ----
DEF _SRAM_A EQU $A000
DEF _SRAM_B EQU $B000
